# 로컬 개발용(next dev). 실제 값은 .env.local 에 넣고 커밋하지 않는다.
# Supabase 대시보드 → Project Settings → API 에서 확인. publishable 키는 브라우저에 나가도 되는 키다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Cloudflare Turnstile 사이트 키(공개 값). 로컬은 공개 시험 키(보이지 않음·항상 통과) 1x00000000000000000000BB.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
# 웹 푸시 공개 VAPID 키(공개 값, #7). 개인 키는 Edge Function 비밀값 VAPID_PRIVATE_KEY 에만 둔다. 없으면 "알림 받기" 칸이 숨는다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 사이트 주소(#8). 공유 미리보기 이미지·manifest 의 절대 주소에 쓴다. 비우면 http://localhost:3104.
NEXT_PUBLIC_SITE_URL=http://localhost:3104
